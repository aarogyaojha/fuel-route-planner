# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-fuel-route-planner-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SETTINGS_MODULE=config.settings.local

# Database Configuration (PostgreSQL ready, SQLite local default)
# Local SQLite default:
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/fuel_planner_db

# Routing and Fuel Optimization Settings
ORS_API_KEY=
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10.0
CORRIDOR_RADIUS_MILES=10.0